<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-only explicit publication/history isolation. Requires
     RMW_FASTRTPS_USE_QOS_FROM_XML=1. Not a production/default fix. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>cupcup_test_udp_async</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="cupcup_test_udp_async" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>cupcup_test_udp_async</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <data_writer profile_name="cupcup_test_async_writer" is_default_profile="true">
    <qos><publishMode><kind>ASYNCHRONOUS</kind></publishMode></qos>
    <historyMemoryPolicy>DYNAMIC</historyMemoryPolicy>
  </data_writer>
  <data_reader profile_name="cupcup_test_dynamic_reader" is_default_profile="true">
    <historyMemoryPolicy>DYNAMIC</historyMemoryPolicy>
  </data_reader>
</profiles>
